---
import SectionHead from './SectionHead.astro';
import { CONTENT } from '../lib/site.js';

const { lang } = Astro.props;
const t = CONTENT[lang];
---
<section class="section section--paper" id="about">
  <div class="wrap">
    <SectionHead title={t.about.title} lede={t.about.lede} />

    <div class="about__grid">
      <div class="about__body reveal">
        {t.about.paragraphs.map((para) => <p>{para}</p>)}
      </div>

      <aside class="about__philosophy reveal">
        <h3>{t.about.philosophyTitle}</h3>
        {t.about.philosophy.map((para) => <p>{para}</p>)}
      </aside>
    </div>
  </div>
</section>
