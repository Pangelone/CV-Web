---
import Seo from '../components/Seo.astro';
import Nav from '../components/Nav.astro';
import Icon from '../components/Icon.astro';
import { CONTENT, shared, waLink } from '../lib/site.js';

import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/print.css';

const { lang } = Astro.props;
const t = CONTENT[lang];
const p = shared.person;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={lang} class="no-js">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#2563EB" />

  <Seo lang={lang} />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate icon" href="/favicon.ico" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <link
    rel="preload"
    href="/fonts/open-sans-latin.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />

  <script is:inline>
    document.documentElement.classList.remove('no-js');
  </script>
</head>

<body>
  <a class="skip-link" href="#about">{t.ui.skipToContent}</a>

  <Nav lang={lang} />

  <main id="main">
    <slot />
  </main>

  <footer class="footer">
    <div class="wrap footer__inner">
      <span>© {year} {p.name} · {t.hero.role} · {t.hero.roleAccent}</span>
      <span>
        <a href={p.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <span aria-hidden="true"> · </span>
        <a href={`mailto:${p.email}`}>{t.ui.email}</a>
        <span aria-hidden="true"> · </span>
        <a href="#top">{t.ui.backToTop}</a>
      </span>
    </div>
  </footer>

  <a
    class="wa"
    href={waLink('Hola Pablo!')}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={t.ui.whatsapp}
  >
    <Icon name="whatsapp" />
  </a>

  <script
    is:inline
    define:vars={{
      lang,
      copied: t.ui.shareCopied,
      promptText: t.ui.sharePrompt,
      shareTitle: `${p.name} — ${t.hero.role} · ${t.hero.roleAccent}`,
      shareText: t.hero.tagline,
    }}
  >
    (function () {
      'use strict';

      /* ── Scroll reveal ─────────────────────────────────────────────── */
      var revealables = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window)) {
        revealables.forEach(function (el) { el.classList.add('is-in'); });
      } else {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.06 });
        revealables.forEach(function (el) { io.observe(el); });

        /* Safety net: never leave content invisible if the observer never
           fires for an element (deep-link jumps, restored scroll, bfcache). */
        setTimeout(function () {
          revealables.forEach(function (el) { el.classList.add('is-in'); });
        }, 2500);
      }

      /* ── Scrollspy ─────────────────────────────────────────────────── */
      var navLinks = Array.prototype.slice.call(document.querySelectorAll('[data-nav]'));
      var sections = navLinks
        .map(function (link) { return document.getElementById(link.dataset.nav); })
        .filter(Boolean);

      if (sections.length && 'IntersectionObserver' in window) {
        var visible = new Map();
        var spy = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            visible.set(entry.target.id, entry.isIntersecting ? entry.intersectionRatio : 0);
          });
          var best = '';
          var bestRatio = 0;
          visible.forEach(function (ratio, id) {
            if (ratio > bestRatio) { bestRatio = ratio; best = id; }
          });
          navLinks.forEach(function (link) {
            if (link.dataset.nav === best && bestRatio > 0) {
              link.setAttribute('aria-current', 'true');
            } else {
              link.removeAttribute('aria-current');
            }
          });
        }, { threshold: [0, 0.15, 0.35, 0.6], rootMargin: '-15% 0px -45% 0px' });
        sections.forEach(function (section) { spy.observe(section); });
      }

      /* ── Mobile menu ───────────────────────────────────────────────── */
      var toggle = document.getElementById('nav-toggle');
      var rail = document.getElementById('rail');
      if (toggle && rail) {
        var setOpen = function (open) {
          rail.dataset.open = open ? 'true' : 'false';
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        };
        toggle.addEventListener('click', function () {
          setOpen(rail.dataset.open !== 'true');
        });
        rail.addEventListener('click', function (event) {
          if (event.target.closest('a')) setOpen(false);
        });
        document.addEventListener('keydown', function (event) {
          if (event.key === 'Escape') setOpen(false);
        });
        document.addEventListener('click', function (event) {
          if (window.innerWidth > 991) return;
          if (rail.dataset.open !== 'true') return;
          if (rail.contains(event.target) || toggle.contains(event.target)) return;
          setOpen(false);
        });
      }

      /* ── Earlier-career accordion ──────────────────────────────────── */
      var earlierToggle = document.getElementById('earlier-toggle');
      var earlierPanel = document.getElementById('earlier-panel');
      if (earlierToggle && earlierPanel) {
        earlierToggle.addEventListener('click', function () {
          var open = earlierPanel.dataset.open !== 'true';
          earlierPanel.dataset.open = open ? 'true' : 'false';
          earlierToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
      }

      /* ── Toast ─────────────────────────────────────────────────────── */
      var toastEl = document.getElementById('toast');
      var toastTimer;
      function toast(message) {
        if (!toastEl) return;
        toastEl.textContent = message;
        toastEl.dataset.show = 'true';
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () { toastEl.dataset.show = 'false'; }, 2600);
      }

      /* ── Share ─────────────────────────────────────────────────────── */
      var shareBtn = document.getElementById('share-btn');
      if (shareBtn) {
        shareBtn.addEventListener('click', async function () {
          var url = window.location.href.split('#')[0];
          var payload = { title: shareTitle, text: shareText, url: url };

          if (navigator.share) {
            try { await navigator.share(payload); return; }
            catch (error) { if (error && error.name === 'AbortError') return; }
          }
          try {
            await navigator.clipboard.writeText(url);
            toast(copied);
          } catch (error) {
            window.prompt(promptText, url);
          }
        });
      }

      /* ── Top bar: opaque once it leaves the hero ───────────────────── */
      var topbar = document.getElementById('topbar');
      if (topbar) {
        var hero = document.querySelector('.hero');
        /* Flip only when the bar actually leaves the hero. A fixed 60px
           threshold turned the bar white on the first scroll notch, while
           it was still sitting on the dark artwork. */
        var syncBar = function () {
          var limit = hero ? Math.max(80, hero.offsetHeight - topbar.offsetHeight - 12) : 80;
          topbar.dataset.scrolled = window.scrollY > limit ? 'true' : 'false';
        };
        syncBar();
        window.addEventListener('scroll', syncBar, { passive: true });
        window.addEventListener('resize', syncBar, { passive: true });
      }

      /* ── Language menu: close on outside click and on Escape ───────── */
      var langMenu = document.getElementById('lang-menu');
      if (langMenu) {
        document.addEventListener('click', function (event) {
          if (!langMenu.open) return;
          if (!langMenu.contains(event.target)) langMenu.open = false;
        });
        document.addEventListener('keydown', function (event) {
          if (event.key === 'Escape') langMenu.open = false;
        });
      }

      /* ── Language: remember the choice, detect on first visit ──────── */
      var KEY = 'pa.lang';
      document.querySelectorAll('.lang__item').forEach(function (link) {
        link.addEventListener('click', function () {
          try { localStorage.setItem(KEY, link.getAttribute('lang')); } catch (error) {}
        });
      });

      if (lang === 'en' && !sessionStorage.getItem('pa.langChecked')) {
        try { sessionStorage.setItem('pa.langChecked', '1'); } catch (error) {}
        var stored = null;
        try { stored = localStorage.getItem(KEY); } catch (error) {}
        var detected = stored || (navigator.language || 'en').slice(0, 2).toLowerCase();
        if (['es', 'pt', 'it', 'fr'].indexOf(detected) !== -1) {
          window.location.replace('/' + detected);
        }
      }
    })();
  </script>
</body>
</html>
